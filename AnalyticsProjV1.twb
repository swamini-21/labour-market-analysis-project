      <aliases enabled='yes' />
      <column caption='Selected Year Wage' datatype='real' name='[Calculation_0665232692469762]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [occ_title], [year] : AVG([value]) }' />
      </column>
      <column caption='Mean Annual Wage' datatype='real' name='[Calculation_0687773157654528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [metric_code] = &quot;OES_MAW&quot; THEN [value] END' />
      </column>
      <column caption='Total Employment' datatype='real' name='[Calculation_0687773157756929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [metric_code] = &quot;OES_EMP&quot; THEN [value] END' />
      </column>
      <column caption='Wage 2016' datatype='real' name='[Calculation_0687773162033154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [occ_title] : SUM(IF YEAR([full_date]) = 2016 THEN [Calculation_0687773157654528] END) }' />
      </column>
      <column caption='Wage 2025' datatype='real' name='[Calculation_0687773173813256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [occ_title] : SUM(IF YEAR([full_date]) = 2025 THEN [Calculation_0687773157654528] END) }' />
      </column>
      <column caption='Wage Growth %' datatype='real' name='[Calculation_0687773173866505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_0687773173813256]-[Calculation_0687773162033154])/ABS([Calculation_0687773162033154])' />
      </column>
