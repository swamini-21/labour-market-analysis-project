        <calculation class='tableau' formula='IF YEAR([full_date]) &lt; 2020 THEN &quot;Pre-COVID (2016-2019)&quot;&#13;&#10;ELSEIF YEAR([full_date]) = 2020 THEN &quot;COVID Year (2020)&quot;&#13;&#10;ELSEIF YEAR([full_date]) &lt;= 2022 THEN &quot;Recovery (2021-2022)&quot;&#13;&#10;ELSE &quot;Post-Recovery (2023-2025)&quot;&#13;&#10;END' />
